+    private static void ProbeLog(string line) =>
+        File.AppendAllText(
+            Environment.GetEnvironmentVariable("PTK_PROBE_LOG") ??
+                Path.Combine(Path.GetTempPath(), "ptk-probe.log"),
+            line + Environment.NewLine);
