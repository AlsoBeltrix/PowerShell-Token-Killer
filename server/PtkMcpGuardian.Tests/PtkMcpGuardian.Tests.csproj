<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Serializes this assembly (see xunit.runner.json). Its tests launch real
    guardian, host and worker processes, so it saturates a low-core host on its
    own and loses timing-sensitive tests there; measured evidence and the
    rejected alternatives are in .agents/review/findings/r6x-5.md.
  -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PtkMcpGuardian\PtkMcpGuardian.csproj" />
    <ProjectReference Include="..\PtkMcpServer\PtkMcpServer.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PtkResilienceTestFixture\PtkResilienceTestFixture.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
