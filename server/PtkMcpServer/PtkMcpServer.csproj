<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PtkNativeCompiler Condition="'$(PtkNativeCompiler)' == ''">cc</PtkNativeCompiler>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.3" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PtkMcpServer.Tests" />
    <InternalsVisibleTo Include="PtkContainmentTestFixture" />
    <InternalsVisibleTo Include="PtkAuditAdmin" />
  </ItemGroup>

  <Target
    Name="BuildPtkWorkerBroker"
    AfterTargets="Build"
    Condition="'$(OS)' != 'Windows_NT'"
    Inputs="$(MSBuildProjectDirectory)/Native/ptk_worker_broker.c;$(MSBuildProjectFullPath)"
    Outputs="$(TargetDir)PtkWorkerBroker">
    <Exec
      Command="&quot;$(PtkNativeCompiler)&quot; -std=c17 -O2 -fno-common -fstack-protector-strong -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wmissing-prototypes &quot;$(MSBuildProjectDirectory)/Native/ptk_worker_broker.c&quot; -o &quot;$(TargetDir)PtkWorkerBroker&quot;" />
  </Target>

</Project>
