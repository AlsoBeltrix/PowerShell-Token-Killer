<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Overridden by release CI via -p:Version from the tag; this is the
         value a plain local build reports. -->
    <Version Condition="'$(Version)' == ''">0.2.0</Version>
    <PtkBuildIdentity Condition="'$(PtkBuildIdentity)' == ''">$([System.Guid]::NewGuid().ToString('N'))</PtkBuildIdentity>
    <Product>PowerShell Token Killer</Product>
    <Company>PowerShell-Token-Killer</Company>
    <Copyright>(c) 2026 PowerShell Token Killer contributors. Licensed under the Apache License, Version 2.0.</Copyright>
    <PtkNativeCompiler Condition="'$(PtkNativeCompiler)' == ''">cc</PtkNativeCompiler>
    <PtkWorkerBrokerPath
      Condition="'$(OS)' != 'Windows_NT'">$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/ptk-native/$(RuntimeIdentifier)/PtkWorkerBroker</PtkWorkerBrokerPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.3" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <!-- Override PowerShell SDK's vulnerable 10.0.6 transitive minimum. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PtkMcpServer.Tests" />
    <InternalsVisibleTo Include="PtkContainmentTestFixture" />
    <InternalsVisibleTo Include="PtkAuditAdmin" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <None
      Include="$(PtkWorkerBrokerPath)"
      Link="PtkWorkerBroker"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Source and per-build identity ride in the informational version. Package
       builders pass both explicitly; ordinary local builds discover source and
       allocate a fresh identity here. -->
  <Target Name="PtkStampSourceCommit" BeforeTargets="GetAssemblyAttributes">
    <Exec Condition="'$(PtkSourceCommit)' == ''"
          Command="git rev-parse --short HEAD"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          ContinueOnError="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="PtkDetectedSourceCommit" />
      <Output TaskParameter="ExitCode" PropertyName="PtkSourceCommitExitCode" />
    </Exec>
    <PropertyGroup>
      <PtkSourceCommit Condition="'$(PtkSourceCommit)' == '' and '$(PtkSourceCommitExitCode)' == '0' and '$(PtkDetectedSourceCommit)' != ''">$(PtkDetectedSourceCommit.Trim())</PtkSourceCommit>
      <PtkSourceCommit Condition="'$(PtkSourceCommit)' == ''">unknown</PtkSourceCommit>
      <InformationalVersion>$(Version)+$(PtkSourceCommit).build.$(PtkBuildIdentity)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <Target
    Name="BuildPtkWorkerBroker"
    BeforeTargets="GetCopyToOutputDirectoryItems;ComputeFilesToPublish"
    Condition="'$(OS)' != 'Windows_NT'"
    Inputs="$(MSBuildProjectDirectory)/Native/ptk_worker_broker.c;$(MSBuildProjectFullPath)"
    Outputs="$(PtkWorkerBrokerPath)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(PtkWorkerBrokerPath)'))" />
    <Exec
      Command="&quot;$(PtkNativeCompiler)&quot; -std=c17 -O2 -fno-common -fstack-protector-strong -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wmissing-prototypes &quot;$(MSBuildProjectDirectory)/Native/ptk_worker_broker.c&quot; -o &quot;$(PtkWorkerBrokerPath)&quot;" />
  </Target>

</Project>
