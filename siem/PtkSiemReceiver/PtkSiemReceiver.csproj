<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Release packaging overrides Version; keep ordinary local builds on
         the same product line rather than the SDK's unrelated 1.0.0. -->
    <Version Condition="'$(Version)' == ''">0.2.0</Version>
    <Product>PowerShell Token Killer SIEM Receiver</Product>
    <Company>PowerShell-Token-Killer</Company>
    <Copyright>(c) 2026 PowerShell Token Killer contributors. Licensed under the Apache License, Version 2.0.</Copyright>
  </PropertyGroup>

  <Target Name="PtkSiemStampSourceCommit" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short HEAD"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          ContinueOnError="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="PtkSiemSourceCommit" />
      <Output TaskParameter="ExitCode" PropertyName="PtkSiemSourceCommitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(PtkSiemSourceCommitExitCode)' == '0' and '$(PtkSiemSourceCommit)' != ''">
      <InformationalVersion>$(Version)+$(PtkSiemSourceCommit.Trim())</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="PtkSiemReceiver.Tests" />
    <InternalsVisibleTo Include="PtkSiemReceiver.TestHost" />
    <InternalsVisibleTo Include="PtkMcpServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.82.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Override the provider's 2.1.11 minimum to the patched native bundle. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/audit_otlp.proto" GrpcServices="None" />
  </ItemGroup>

</Project>
